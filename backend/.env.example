# ==========================================
# ENTERPRISE URL SHORTENER BACKEND SECRETS
# ==========================================

# 🌐 Production Custom Domain (e.g. https://go.mybrand.com or https://short.link)
# If left blank, it dynamically uses the incoming HTTP Host request header.
BASE_URL=https://go.mybrand.com

# Node Server Port
PORT=5000

# Security JWT Secret Key (Required for production authentication)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# 🐘 PostgreSQL Database Credentials
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_pass
POSTGRES_DB=url_shortener

# ⚡ Redis Cache Credentials
REDIS_HOST=localhost
REDIS_PORT=6379
